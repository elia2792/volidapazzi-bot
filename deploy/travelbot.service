[Unit]
Description=Telegram Travel & Flight Deals Bot 24/7
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/telegram-travel-bot
ExecStart=/opt/telegram-travel-bot/.venv/bin/python main.py
Restart=always
RestartSec=10
EnvironmentFile=/opt/telegram-travel-bot/.env

[Install]
WantedBy=multi-user.target
