# ==========================================
# CONFIGURAZIONE BOT TELEGRAM VIAGGI 24/7
# ==========================================

# 1. Credenziali Telegram
# Crea il tuo bot su Telegram cercando @BotFather e copia il token qui:
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz1234567

# Inserisci l'username del tuo canale Telegram (es. @TuoCanaleViaggi) o l'ID numerico (-100xxxxxxxxx).
# Ricorda di nominare il tuo bot AMMINISTRATORE del canale con permesso di pubblicare messaggi!
TELEGRAM_CHANNEL_ID=@tuo_canale_offerte_viaggi

# (Opzionale) Il tuo ID utente Telegram per notifiche admin e statistiche
TELEGRAM_ADMIN_ID=123456789

# ==========================================
# IMPOSTAZIONI DI MONETIZZAZIONE (AFFILIAZIONI)
# ==========================================
# Iscriviti gratuitamente ai programmi partner per iniziare a guadagnare:

# Travelpayouts (Per voli Aviasales, WayAway, Kiwi, Trip.com) -> Registrati su https://www.travelpayouts.com
TRAVELPAYOUTS_MARKER=500000

# Booking.com Affiliate Partner -> https://www.booking.com/affiliate-program/
BOOKING_AID=2400000

# Skyscanner Affiliate
SKYSCANNER_AFFILIATE_TAG=travelbot

# Civitatis (Tour ed escursioni in tutto il mondo) -> https://www.civitatis.com/it/affiliati/
CIVITATIS_AFFILIATE_ID=travelbot

# GetYourGuide Partner -> https://partner.getyourguide.com
GETYOURGUIDE_PARTNER_ID=travelbot

# Amazon Associates (Per guide, zaini bagaglio a mano omologati, adattatori) -> https://programma-affiliazione.amazon.it
AMAZON_AFFILIATE_TAG=travelbot-21

# ==========================================
# FREQUENZA E FILTRI
# ==========================================
# Intervallo tra le scansioni in minuti (60 = ogni ora, 24/7)
CHECK_INTERVAL_MINUTES=60

# Numero massimo di offerte da pubblicare per ogni ciclo orario (per non intasare il canale)
MAX_DEALS_PER_RUN=3

# Pubblica automaticamente una guida o trucco di viaggio al giorno
PUBLISH_GUIDES_DAILY=True

# Percorso database SQLite locale
DB_PATH=deals.db
LOG_LEVEL=INFO
